# Mohasba Tracker v2 — Server-Only Environment Variables
# Copy to `.env.local` for local development or inject in Docker/VPS runtime.
# NEVER expose SUPABASE_SERVICE_ROLE_KEY, CRON_SECRET, APP_PASSCODE, or NTFY_TOPIC_URL to the browser (zero NEXT_PUBLIC_*).

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
CRON_SECRET=replace-with-32-plus-char-random-secret
APP_URL=http://localhost:3000
APP_PASSCODE=replace-with-personal-passcode
NTFY_TOPIC_URL=https://ntfy.sh/replace-with-private-topic

# Optional Cloudflare Tunnel token (used by `docker compose --profile tunnel up -d`):
# CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token

# Optional local development & test-only variables (uncomment only in local .env.local):
# ALLOW_UNAUTHENTICATED=true
# ALLOW_TEST_DB_RESET=true
# TEST_SUPABASE_REF=your-test-project-ref
# SUPABASE_ANON_KEY_FOR_TESTS=your-test-supabase-anon-key
